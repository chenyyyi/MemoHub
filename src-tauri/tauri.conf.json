{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MemoHub",
  "version": "0.3.0",
  "identifier": "com.memohub.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "MemoHub",
        "width": 480,
        "height": 500,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
      "active": true,
      "targets": "all",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "windows": {
        "nsis": {
          "languages": ["SimpChinese", "English"]
        },
        "wix": {
          "language": "zh-CN"
        }
      }
    }
}
